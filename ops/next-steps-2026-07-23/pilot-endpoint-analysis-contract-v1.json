  "status": "implementation_template_synthetic_only_no_research_authorization",
  "approved_endpoint_contract_id": "mp-pilot-endpoint-design-amendment-v1",
  "source_basis": {
    "primary_reference": "Cooper et al., A dataset of rated conceptual arguments, especially Section 2 and Appendices B, C, D, and F",
    "source_derived_rules": [
      "seven 0-to-1 rating dimensions",
      "centrality times strength as substantive impact",
      "directional LMCA custom weighted loss",
      "same-position comparison structure",
      "blind initials and preserved original ratings"
    ],
    "metaphilosophy_extensions": [
      "position-first absolute human-human gaps",
      "symmetric average of both directional LMCA custom-loss directions",
      "unweighted-first ordering robustness",
      "average absolute within-rater gap as the optional ordering weight",
      "leave-one-position and leave-one-rater finite-pilot sensitivity",
      "balanced blind self-check stage",
      "all-pair dual-blind interpretation-cause coding"
    ]
  },
  "primary_endpoints": {
    "P1": "twelve position-level mean absolute overall and centrality-times-strength gaps, followed by equal-position mean, median, interquartile range, and full range",
    "P2": "all-48 paired interpretation-cause analysis from two immutable blind initial codes per pair",
    "P3": "completion, active time, self-check, integrity, review, adjudication, and unresolved burden"
  },
  "secondary_endpoints": {
    "S1": "symmetric two-direction LMCA-style discrepancy, labelled a Metaphilosophy extension rather than ground-truth error",
    "S2": "unweighted ordering agreement first; optional weight equals the average of the two raters' absolute within-rater overall gaps",
    "S3": "stage-separated blind initial, blind self-check, post-peer or post-evidence revision, adjudicated latest accepted, and unresolved records",
    "S4": "leave-one-position, leave-one-rater, equal-position mean, and position-median sensitivity"
  },
  "complete_structure": {
    "positions": 12,
    "critiques": 48,
    "blind_initial_ratings": 96,
    "blind_self_check_records": 24,
    "interpretation_cause_code_records": 96,
