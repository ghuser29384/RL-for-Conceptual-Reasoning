      "critique_quantities": [
        "absolute_overall_gap",
        "absolute_centrality_times_strength_gap"
      ],
      "position_summary": "arithmetic mean across four paired critiques",
      "pilot_summary": [
        "all twelve position blocks",
        "equal-position-weighted mean",
        "position median",
        "interquartile range",
        "full range"
      ],
      "single_scalar_success_rule": false
    },
    {
      "id": "P2_interpretation_linkage",
      "requires_pre_peer_fingerprint": true,
      "required_fields": [
        "position_conclusion_summary_once_per_rater_position_before_first_sibling_lock",
        "critique_target_summary_per_critique",
        "priced_in_assessment_no_partly_yes_uncertain",
        "interpretation_confidence_high_medium_low",
        "background_assumptions_when_low_confidence_or_uncertain",
        "position_ambiguity_flag",
        "critique_ambiguity_flag",
        "insufficient_context_flag"
      ],
      "cause_codes": [
        "compatible_interpretations",
        "material_position_conclusion_difference",
        "material_critique_target_or_claim_difference",
        "priced_in_disagreement",
        "background_assumption_disagreement",
        "score_calibration_or_rubric_allocation_only",
        "substantive_object_level_disagreement",
        "mixed_cause",
        "unresolved_or_indeterminate"
      ],
      "coding_coverage": "all_48_pairs_dual_independent_blind"
    },
    {
      "id": "P3_operational_feasibility_and_burden",
      "components": [
        "accepted blind initials over 96",
        "complete paired critiques over 48",
        "complete position blocks over 12",
        "total and distributional active rating time",
        "identity-free position and pseudonymous-rater time summaries",
        "safe decline rejection replacement integrity verification self-check revision adjudication and unresolved counts",
        "adjudicator active time where applicable"
      ],
      "lmca_five_to_fifteen_minute_range_is_a_pass_threshold": false
    }
  ],
  "owner_decisions": {
    "D1_blind_self_check_scope": {
      "selected_option": "B",
      "status": "approved",
      "label": "balanced_24_rating_subsample",
      "self_check_records": 24,
      "selected_positions": 6,
      "topic_families_represented": 6,
      "positions_per_topic_family": 1,
      "approved_source_classes": 2,
      "positions_per_source_class": 3,
      "selected_critiques_per_position": 2,
      "self_checks_per_core_rater": 4,
      "selected_positions_per_core_rater": 2,
      "both_original_raters_self_check_each_selected_critique": true,
      "selection_frozen_before_any_pilot_rating": true,
      "selection_independent_of_observed_human_scores": true,
