  "secondary_endpoints": [
    {
      "id": "S1_symmetric_lmca_style_discrepancy",
      "definition": "(lmca_custom_weighted_loss(a,b) + lmca_custom_weighted_loss(b,a)) / 2",
      "classification": "Metaphilosophy extension, not an LMCA source metric or ground-truth error",
      "mixed_clarity_pairs_reported_separately": true
    },
    {
      "id": "S2_within_position_ordering_robustness",
      "unweighted_agreement_reported_first": true,
      "weighted_pair_weight": "(abs(delta_overall_rater_a) + abs(delta_overall_rater_b)) / 2",
      "forbidden_weight": "absolute difference between two-rater mean scores",
      "aggregate_position_first": true
    },
    {
      "id": "S3_stage_separated_change",
      "stages": [
        "blind_initial",
        "blind_self_check",
        "post_peer_or_post_evidence_revision",
        "adjudicated_latest_accepted",
        "unresolved"
      ],
      "causal_discussion_claim_authorized": false
    },
    {
      "id": "S4_composition_and_aggregation_sensitivity",
      "components": [
        "leave_one_position_out_range",
        "leave_one_rater_out_range_using_eight_unaffected_positions",
        "equal-position mean",
        "position median",
        "conclusion stability table"
      ],
      "reliability_weighting": false
    }
  ],
  "exploratory_only": [
    "interval Krippendorff alpha",
    "ICC or mixed-model variance decomposition",
    "topic source length style-cue and order associations",
