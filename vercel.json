{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && node scripts/verify-vercel-oidc-staging-gateway.mjs",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": false,
      "release/vercel-preview": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "rewrites": [
    {
      "source": "/staging",
      "destination": "/staging/index.html"
    },
    {
      "source": "/staging/",
      "destination": "/staging/index.html"
    },
    {
      "source": "/research",
      "destination": "/research/index.html"
    },
    {
      "source": "/research/",
      "destination": "/research/index.html"
    },
    {
      "source": "/workspace",
      "destination": "/index.html"
    },
    {
      "source": "/workspace/",
      "destination": "/index.html"
    },
    {
      "source": "/reference",
      "destination": "/index.html"
    },
    {
      "source": "/reference/",
      "destination": "/index.html"
    },
    {
      "source": "/contribute",
      "destination": "/reviewers/closed.html"
    },
    {
      "source": "/contribute/",
      "destination": "/reviewers/closed.html"
    },
    {
      "source": "/reviewers",
      "destination": "/reviewers/closed.html"
    },
    {
      "source": "/reviewers/",
      "destination": "/reviewers/closed.html"
    },
    {
      "source": "/reviewers/index.html",
      "destination": "/reviewers/closed.html"
    }
  ],
  "redirects": [
    {
      "source": "/src/assets/LMCA_dataset.pdf",
      "destination": "https://arxiv.org/pdf/2607.27499",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/staging/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow,noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/api/staging",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 300
    }
  }
}
