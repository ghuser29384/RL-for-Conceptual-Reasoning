{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/research",
      "destination": "/research/index.html"
    },
    {
      "source": "/research/",
      "destination": "/research/index.html"
    },
    {
      "source": "/contribute",
      "destination": "/reviewers/closed.html"
    },
    {
      "source": "/contribute/",
      "destination": "/reviewers/closed.html"
    },
    {
      "source": "/reviewers",
      "destination": "/reviewers/closed.html"
    },
    {
      "source": "/reviewers/",
      "destination": "/reviewers/closed.html"
    },
    {
      "source": "/reviewers/index.html",
      "destination": "/reviewers/closed.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 300
    }
  }
}
